{
  "name": "whisper-cloudflare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "mkdir -p public/ffmpeg-umd && cp node_modules/@ffmpeg/ffmpeg/dist/umd/*.js public/ffmpeg-umd/",
    "deploy": "npm run postinstall && wrangler deploy",
    "dev": "npm run postinstall && wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15"
  }
}
